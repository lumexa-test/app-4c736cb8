generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy pattern ────────────────────────────────────────────────────
// tenantId is a string key that scopes every row to a specific project/tenant.
// For the MVP generator: each generated project gets its own tenantId value.
// Always filter queries by tenantId when serving multi-tenant data.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  // Additive extension on top of "auth is done" — every domain page needs a
  // human name to show instead of email/id. Nullable so the frozen
  // seed.ts admin-upsert (which never sets it) keeps working; callers fall
  // back to the email local-part when null (see backend/src/lib/displayName.ts).
  displayName String?  @map("display_name")
  tenantId    String   @default("default") @map("tenant_id")
  // Every generated app ships with admin support out of the box. The
  // first admin row is created by `prisma/seed.ts` (idempotent upsert);
  // additional admins are promoted by toggling this flag.
  isAdmin     Boolean  @default(false) @map("is_admin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("users")
}

// ── DOMAIN MODELS GO HERE ─────────────────────────────────────────────
// Add the app's domain models below. Every user-visible lifecycle event
// gets a timestamp field; humans are displayed by name, never email/id.

// Per-tenant configuration: Slack alert channel + the video-generation API
// key. Google Veo / Slack are "planned for a future version" per the PRD, so
// this table gates + simulates them rather than calling real external APIs.
model TenantSettings {
  id             Int      @id @default(autoincrement())
  tenantId       String   @unique @map("tenant_id")
  slackConnected Boolean  @default(false) @map("slack_connected")
  slackChannel   String?  @map("slack_channel")
  veoApiKey      String?  @map("veo_api_key")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model VideoJob {
  id                 Int      @id @default(autoincrement())
  tenantId           String   @map("tenant_id")
  creatorId          Int      @map("creator_id")
  creatorDisplayName String   @map("creator_display_name")
  title              String
  prompt             String
  mode               String   // 'text' | 'image'
  sourceImageUrl     String?  @map("source_image_url")
  status             String   @default("queued") // queued | rendering | completed | failed
  videoUrl           String?  @map("video_url")
  errorMessage       String?  @map("error_message")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([creatorId])
  @@map("video_jobs")
}

// Workspace feed — one shared, tenant-wide channel-style stream.
model Message {
  id                Int      @id @default(autoincrement())
  tenantId          String   @map("tenant_id")
  authorId          Int      @map("author_id")
  authorDisplayName String   @map("author_display_name")
  body              String
  isBot             Boolean  @default(false) @map("is_bot")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("messages")
}

// 1:1 direct messages between any two workspace members.
model DirectMessage {
  id                   Int      @id @default(autoincrement())
  tenantId             String   @map("tenant_id")
  senderId             Int      @map("sender_id")
  senderDisplayName    String   @map("sender_display_name")
  recipientId          Int      @map("recipient_id")
  recipientDisplayName String   @map("recipient_display_name")
  body                 String
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([senderId])
  @@index([recipientId])
  @@map("direct_messages")
}

model SlackConnection {
  id           String    @id @default(uuid())
  // The app's own User.id. NO Prisma @relation: schemaAppend is append-only and
  // a relation would require adding a back-reference field to model User.
  userId       Int       @unique @map("user_id")
  slackUserId  String    @map("slack_user_id")
  teamId       String    @default("") @map("team_id")
  teamName     String    @default("") @map("team_name")
  // Nullable so a dead grant keeps its identity (workspace, chosen channel)
  // while holding no secrets — that is what lets the UI say "Reconnect".
  accessToken  String?   @map("access_token")
  scope        String    @default("")
  // Where THIS user wants their alerts. Null until they pick one; sends are
  // skipped (never guessed) while it is null.
  channelId    String?   @map("channel_id")
  channelName  String?   @map("channel_name")
  // Set when Slack rejects the token. NEVER set on a 5xx, a rate limit, or a
  // channel error — that would disconnect every user of the app at once.
  needsReauth  Boolean   @default(false) @map("needs_reauth")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([slackUserId])
  @@map("slack_connections")
}

model SlackOAuthState {
  // The opaque `state` sent to Slack. Single-use: the callback deletes it
  // before validating anything else, so a replayed callback finds nothing.
  state       String   @id
  userId      Int      @map("user_id")
  // The EXACT redirect_uri sent at authorize time, replayed byte-for-byte in
  // the token exchange. Stored rather than recomputed so a host change
  // mid-flight (live preview -> deploy, custom domain attach) cannot break it.
  redirectUri String   @map("redirect_uri")
  // Where to send the browser afterwards. Validated as an app-relative path.
  returnTo    String?  @map("return_to")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("slack_oauth_states")
}
